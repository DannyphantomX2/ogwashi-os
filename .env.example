# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit it, and never paste it anywhere public.

# Your Neon connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A long random string used to sign login cookies (at least 32 characters).
# Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-the-64-characters-from-the-command-above
